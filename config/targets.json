{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0",
  "description": "Allowlist of authorized target domains for SiteSentinel auditing.",
  "targets": [
    {
      "id": "target-local-test-site",
      "name": "SiteSentinel Local Testbed",
      "domain": "localhost:4000",
      "allowedProtocols": ["http", "https"],
      "startUrls": [
        "http://localhost:4000/",
        "http://localhost:4000/slow",
        "http://localhost:4000/admin",
        "http://localhost:4000/broken-link-target"
      ],
      "maxPagesPerRun": 25,
      "maxDepth": 3,
      "contactEmail": "admin@localhost.test",
      "enabled": true
    },
    {
