{
  "name": "SiteSentinel - Approval Digest",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "id": "1",
      "name": "Every 30 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://host.docker.internal:4001/reports/pending",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.API_SECRET_TOKEN || 'sitesentinel_dev_api_key_123' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "2",
      "name": "Fetch Pending Reports",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{ $items().length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "3",
      "name": "Has Pending Items?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "sendTo": "={{ $env.AUDITOR_DIGEST_EMAIL || $env.GMAIL_USER || 'admin@sitesentinel.local' }}",
        "subject": "=SiteSentinel Action Required: {{ $items().length }} Pending Bug Reports for Review",
        "message": "=Hello Auditor,\n\nThere are currently {{ $items().length }} automated bug report(s) triaged by Gemini awaiting your manual review and approval.\n\nReview Queue: http://localhost:3000/review\n\nRemember: In adherence to SiteSentinel Rule 4, no email will be sent to domain owners without explicit manual approval.\n\nBest regards,\nSiteSentinel Automation",
        "options": {}
      },
      "id": "4",
      "name": "Send Email Digest via Gmail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [850, 200]
    }
  ],
  "connections": {
    "Every 30 Minutes": {
      "main": [
        [
          {
            "node": "Fetch Pending Reports",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Pending Reports": {
      "main": [
        [
          {
            "node": "Has Pending Items?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Pending Items?": {
      "main": [
        [
          {
            "node": "Send Email Digest via Gmail",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
