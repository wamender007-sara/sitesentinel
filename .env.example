# ==============================================================================
# SiteSentinel Environment Configuration Template (.env.example)
# Copy this file to .env and populate secret values before running services.
# Rule 6: Never commit actual secret keys or .env files to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database (Docker Compose)
# ------------------------------------------------------------------------------
POSTGRES_USER=sitesentinel
POSTGRES_PASSWORD=sitesentinel_secure_dev_pass
POSTGRES_DB=sitesentinel_db
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Formatted Database URL for Node.js ORMs (Prisma / Drizzle / pg)
DATABASE_URL=postgresql://sitesentinel:sitesentinel_secure_dev_pass@localhost:5432/sitesentinel_db

# ------------------------------------------------------------------------------
# n8n Workflow Automation (Docker Compose)
# ------------------------------------------------------------------------------
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=replace_with_32_char_random_hex_key_for_n8n
WEBHOOK_URL=http://localhost:5678/
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=sitesentinel_admin_pass

# n8n Email Credentials (Gmail integration for approved bug reports)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_16_character_app_password

# ------------------------------------------------------------------------------
# SiteSentinel Fastify API (Local Service)
# ------------------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
API_SECRET_TOKEN=change_me_api_bearer_token

# ------------------------------------------------------------------------------
# SiteSentinel Next.js Dashboard (Local Service)
# ------------------------------------------------------------------------------
DASHBOARD_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ------------------------------------------------------------------------------
# SiteSentinel Scanner & Playwright Engine (Local Service)
# ------------------------------------------------------------------------------
# Rule 2: Minimum 2000ms delay between consecutive requests per domain
SCANNER_RATE_LIMIT_MS=2000
SCANNER_HEADLESS=true
SCANNER_VIEWPORT_WIDTH=1280
SCANNER_VIEWPORT_HEIGHT=800
SCANNER_SCREENSHOTS_DIR=./screenshots
SCANNER_ALLOWLIST_PATH=../config/targets.json

# ------------------------------------------------------------------------------
# Google Gemini API (LLM Bug Summarization & Root-Cause Analysis)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# SiteSentinel Local Buggy Testbed (Local Service)
# ------------------------------------------------------------------------------
TEST_SITE_PORT=8080
